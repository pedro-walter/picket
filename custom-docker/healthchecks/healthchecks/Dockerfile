# Overlay on top of upstream healthchecks/healthchecks, generated by
# /picket-review (docs/reviews/2026-09-13-image-cve.md) to close the 18
# findings with a published Debian trixie-security / PyPI fix that v4.4's
# image doesn't ship yet: perl-base, libpcre2-8-0, libsqlite3-0, gzip,
# libssh2-1t64, libssl3t64, openssl, openssl-provider-legacy (apt) plus
# setuptools, msgpack (pip). v4.4 is confirmed upstream's newest release
# tag (Docker Hub, checked 2026-09-13), so there's no image bump available.
# The other 60 findings on this image have no fix published anywhere yet -
# see the review doc, they're suppressed, not patched here.
#
# The prior souspike/custom-docker/healthchecks overlay (v4.3, removed
# 2026-09-07) hit a frozen snapshot.debian.org apt pin that predated its
# fix and needed pointing at live mirrors first; inherited that here since
# v4.4 may have the same pin - harmless if it turns out not to be needed.
# USER hc is likewise inherited from that same overlay (verified working
# there); re-check with `docker run --rm healthchecks/healthchecks:v4.4
# id hc` if this fails to start after the bump.
#
# Bump BASE_TAG when upstream cuts a release past v4.4; re-run
# /picket-review afterward to see whether this override is still needed.
ARG BASE_TAG=v4.4
FROM healthchecks/healthchecks:${BASE_TAG}

USER root
RUN printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://deb.debian.org/debian-security\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' > /etc/apt/sources.list.d/debian.sources \
    && apt-get update -q \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --only-upgrade \
         perl-base gzip libpcre2-8-0 libsqlite3-0 libssh2-1t64 \
         libssl3t64 openssl openssl-provider-legacy \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -U setuptools msgpack
USER hc
