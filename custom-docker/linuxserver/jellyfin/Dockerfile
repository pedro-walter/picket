# Overlay on top of upstream lscr.io/linuxserver/jellyfin, generated by
# /picket-review (docs/reviews/2026-10-21-image-cve.md) to close the
# curl/libcurl4t64 pair (CVE-2026-92392, HTTP/2 upload use-after-free; fixed
# in Ubuntu 26.04's 8.18.0-1ubuntu2.8). 12.2ubu2604-ls55 is what `latest`
# pointed at (Docker Hub, pushed 2026-10-19, checked 2026-10-21) and still
# ships 8.18.0-1ubuntu2.7; its apt sources are the live resolute suites, so
# no snapshot override is needed.
#
# The base image has no USER directive (s6-overlay's /init runs as root and
# drops to the PUID/PGID `abc` user itself), so none is set here either.
#
# Bump BASE_TAG when linuxserver cuts a build past -ls55; re-run
# /picket-review afterward to see whether this override is still needed.
ARG BASE_TAG=12.2ubu2604-ls55
FROM lscr.io/linuxserver/jellyfin:${BASE_TAG}

RUN apt-get update -q \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --only-upgrade \
      curl libcurl4t64 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
